<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="pvr.directtuner"
  version="@ADDON_VERSION@"
  name="Direct Tuner PVR"
  provider-name="ferrellsl">
  <requires>
    <import addon="kodi.binary.global.main" minversion="2.0.0" version="2.0.2"/>
    <import addon="kodi.binary.global.general" minversion="1.0.4" version="1.0.5"/>
    <import addon="kodi.binary.global.filesystem" minversion="1.1.7" version="1.1.9"/>
    <import addon="kodi.binary.global.tools" minversion="1.0.0" version="1.0.4"/>
    <import addon="kodi.binary.instance.pvr" minversion="8.2.0" version="8.3.0"/>
  </requires>
  <extension
    point="kodi.pvrclient"
    needs_configuration="false"
    library_@ADDON_PLATFORM@="@ADDON_LIBRARY@"/>
  <extension point="xbmc.addon.metadata">
    <platform>@ADDON_PLATFORM_TAG@</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/ferrellsl/Direct-Tuner-PVR</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en_GB">Live TV and recording from an HDHomeRun tuner, with no server or subscription</summary>
    <description lang="en_GB">Watches, pauses and records TV straight from an HDHomeRun tuner on your network. No backend server or DVR subscription is needed. Recordings run only while Kodi is open.</description>
    <disclaimer lang="en_GB">Recordings run only while Kodi is open. Not affiliated with SiliconDust.</disclaimer>
  </extension>
</addon>
